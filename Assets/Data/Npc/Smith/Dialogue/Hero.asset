  lines:
  - text: "\u0414\u043E\u0431\u0440\u043E\u0433\u043E \u0434\u0435\u043D\u044C\u043A\u0430!"
    duration: 1
  - text: "\u0423 \u043C\u0435\u043D\u044F \u0441\u0442\u0430\u043B\u0438 - \u043A\u043E\u0432\u0430\u0442\u044C
      \u043D\u0435 \u043F\u0435\u0440\u0435\u043A\u043E\u0432\u0430\u0442\u044C"
    duration: 1.5
  - text: "\u041A\u043E\u0433\u0434\u0430 - \u0442\u043E \u0438 \u043C\u0435\u043D\u044F
      \u0432\u0435\u043B\u0430 \u0434\u043E\u0440\u043E\u0433\u0430 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439"
