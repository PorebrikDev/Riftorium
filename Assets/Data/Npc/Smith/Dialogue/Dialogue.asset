  m_Script: {fileID: 11500000, guid: 2f93b217cfc13ad4497191dc1936972b, type: 3}
  m_Name: Dialogue
  m_EditorClassIdentifier: 
  lines:
  - text: "\u0427\u0442\u043E-\u0442\u043E \u044F \u0442\u0435\u0431\u044F \u0440\u0430\u043D\u044C\u0448\u0435
      \u043D\u0435 \u0432\u0438\u0434\u0435\u043B... \u0422\u044B \u043E\u0442\u043A\u0443\u0434\u0430
      \u0432 \u043D\u0430\u0448\u0438\u0445 \u043A\u0440\u0430\u044F\u0445?"
  - text: "\u041D\u0435\u0431\u043E\u0441\u044C \u0441 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0437\u0435\u043C\u0435\u043B\u044C? \u041F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F
      \u0432\u043E\u0439\u043D\u0430 \u0438 \u0434\u043E \u043D\u0430\u0441 \u0441\u043A\u043E\u0440\u043E
      \u0434\u043E\u0431\u0435\u0440\u0435\u0442\u0441\u044F"
  - text: " \u042F - \u0413\u0443\u043D\u043D\u0430\u0440, \u041C\u0435\u0441\u0442\u043D\u044B\u0439
      \u043A\u0443\u0437\u043D\u0435\u0446. \u0415\u0441\u043B\u0438 \u043D\u0443\u0436\u044B
      \u0434\u043E\u0431\u0440\u043E\u0442\u043D\u044B\u0435 \u043E\u0440\u0443\u0436\u0438\u0435
      \u0438 \u0431\u0440\u043E\u043E\u043D\u044F - \u044F \u043A \u0442\u0432\u043E\u0438\u043C
      \u0443\u0441\u043B\u0443\u0433\u0430\u043C!"
